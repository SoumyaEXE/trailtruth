# copy to the repo-root .env (gitignored). Every variable is optional.
NPS_API_KEY=                      # https://www.nps.gov/subjects/developer/get-started.htm (DEMO_KEY if empty; rate limited)
TRAILTRUTH_MODEL_PROVIDER=heuristic   # heuristic | tinker | openai  (tinker/openai go through ml/infer.py)
TRAILTRUTH_CHAOS=0                # 1 = fake NPS 503s + model hangs/invalid JSON to show Temporal retries
TRAILTRUTH_CLASSIFY_DELAY=0       # seconds of simulated model latency per alert (demo)
TRAILTRUTH_NPS_CACHE_TTL=21600    # NPS disk-cache TTL in seconds (0 = always hit the live API)
TEMPORAL_ADDRESS=localhost:7233   # Temporal Cloud: <ns>.<acct>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=                 # Temporal Cloud API key (enables TLS)
SENTRY_DSN=                       # enables Sentry AI-agent tracing (gen_ai.* spans)
